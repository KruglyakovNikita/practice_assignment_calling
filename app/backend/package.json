{
  "name": "@auto-calling/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test:p0": "tsx --test test/call-event.unit.test.ts test/crm-retry.unit.test.ts test/security.unit.test.ts",
    "test:p0:integration": "tsx --test test/p0.integration.test.ts",
    "jwt:generate": "tsx src/shared/auth/generate-jwt.ts",
    "test:p1": "tsx --test test/analysis-*.unit.test.ts",
    "test:p1:integration": "tsx --test test/p1.integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "dotenv": "^17.2.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11",
    "@auto-calling/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
